# BotFather bergan token. Haqiqiy .env GitHub'ga yuborilmaydi.
BOT_TOKEN=
# /id buyrug'i bilan olingan Telegram ID; bir nechtasi vergul bilan.
ADMIN_IDS=
DATABASE_PATH=data/bot.sqlite3
BOT_NAME=Logistika Bot
TIMEZONE=Asia/Tashkent

# true: qidiruv, e'lonlar, Batafsil/telefon/manba faqat faol obuna bilan.
# Mahalliy sinov uchun false qiling. Adminlarga kirish doim ochiq.
PAID_ACCESS=true
# Qo'lda karta + chek tasdiqlash. Eski Stars rejimi uchun stars yoziladi.
PAYMENT_MODE=manual
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
# Haqiqiy narxlarni o'zingiz kiriting; 0 bo'lsa tarif sotuvga chiqmaydi.
TARIFF_1_MONTH_UZS=0
TARIFF_2_MONTH_UZS=0
TARIFF_3_MONTH_UZS=0
TARIFF_6_MONTH_UZS=0
# Quyidagi ikkisi faqat PAYMENT_MODE=stars uchun.
# 0: avtomatik sotuv o'chiq; /grant bilan sinash mumkin.
# Narxni o'zingiz belgilang. Telegram Stars butun sonlarda.
PLAN_PRICE_STARS=0
PLAN_DAYS=30
# Sotuvni yoqishdan oldin o'z yordam akkauntingizni kiriting.
SUPPORT_USERNAME=

LISTING_TTL_DAYS=7
PAGE_SIZE=5
SEARCH_LIMIT=5000
SESSION_HOURS=24
# Faqat o'zingiz ulashga ruxsat bergan kanallarning raqamli ID'lari.
SOURCE_CHAT_IDS=
SOURCE_LIMIT=500

# Telegram akkaunt API rekvizitlari: my.telegram.org.
# Login kodi va ikki bosqichli parol faqat collector-login terminalida kiritiladi.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
COLLECTOR_SESSION=data/collector
