# BotFather bergan token. Haqiqiy .env GitHub'ga yuborilmaydi.
BOT_TOKEN=
# /id buyrug'i bilan olingan Telegram ID; bir nechtasi vergul bilan.
ADMIN_IDS=
DATABASE_PATH=data/bot.sqlite3
BOT_NAME=Logistika Bot
TIMEZONE=Asia/Tashkent

# true: ro'yxatlar ochiq, Batafsil/telefon/manba uchun obuna kerak.
# Mahalliy sinov uchun false qiling. Adminlarga kirish doim ochiq.
PAID_ACCESS=true
# 0: avtomatik sotuv o'chiq; /grant bilan sinash mumkin.
# Narxni o'zingiz belgilang. Telegram Stars butun sonlarda.
PLAN_PRICE_STARS=0
PLAN_DAYS=30
# Sotuvni yoqishdan oldin o'z yordam akkauntingizni kiriting.
SUPPORT_USERNAME=

LISTING_TTL_DAYS=7
PAGE_SIZE=5
SEARCH_LIMIT=5000
SESSION_HOURS=24
# Faqat o'zingiz ulashga ruxsat bergan kanallarning raqamli ID'lari.
SOURCE_CHAT_IDS=
